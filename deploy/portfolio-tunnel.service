[Unit]
Description=HTTPS endpoint for the portfolio
After=network-online.target portfolio.service
Wants=network-online.target
Requires=portfolio.service

[Service]
Type=simple
User=loophole
WorkingDirectory=/var/lib/loophole
ExecStart=/usr/local/bin/loophole http 8093 --hostname yousef-portfolio --identity-file /var/lib/loophole/.loophole/.ssh/studyhub_rsa --disable-old-ciphers --disable-proxy-error-page
KillSignal=SIGINT
TimeoutStopSec=10
Restart=on-failure
RestartSec=15
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
